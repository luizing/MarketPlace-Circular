# Para o Render, use a URL JDBC da conexao interna e o perfil docker.
# Para conexoes externas ao Render, inclua ?sslmode=require.
POSTGRES_JDBC_URL=jdbc:postgresql://HOST:5432/BANCO?sslmode=require
POSTGRES_USERNAME=USUARIO
POSTGRES_PASSWORD=SENHA

# Chave JWT em Base64 com pelo menos 32 bytes decodificados.
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_BASE64_SEGURA
